{
  "rewrites": [
    {
      "source": "/listings/new",
      "destination": "/index.html"
    },
    {
      "source": "/listings/leeds",
      "destination": "/listings/leeds/index.html"
    },
    {
      "source": "/listings/manchester",
      "destination": "/listings/manchester/index.html"
    },
    {
      "source": "/listings/birmingham",
      "destination": "/listings/birmingham/index.html"
    },
    {
      "source": "/listings/london",
      "destination": "/listings/london/index.html"
    },
    {
      "source": "/listings/sheffield",
      "destination": "/listings/sheffield/index.html"
    },
    {
      "source": "/listings/bristol",
      "destination": "/listings/bristol/index.html"
    },
    {
      "source": "/listings/liverpool",
      "destination": "/listings/liverpool/index.html"
    },
    {
      "source": "/listings/newcastle",
      "destination": "/listings/newcastle/index.html"
    },
    {
      "source": "/listings/glasgow",
      "destination": "/listings/glasgow/index.html"
    },
    {
      "source": "/listings/cardiff",
      "destination": "/listings/cardiff/index.html"
    },
    {
      "source": "/listings/:slug/edit",
      "destination": "/index.html"
    },
    {
      "source": "/listings/:slug",
      "destination": "/api/public-listing-page?slug=:slug"
    },
    {
      "source": "/edit-listing",
      "destination": "/api/private-page-noindex"
    },
    {
      "source": "/edit-listing/:path*",
      "destination": "/api/private-page-noindex"
    },
    {
      "source": "/feeds/google-merchant.xml",
      "destination": "/api/merchant-product-feed"
    },
    {
      "source": "/feeds/google-merchant",
      "destination": "/api/merchant-product-feed"
    },
    {
      "source": "/((?!.*\\.[^/]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/feeds/google-merchant.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=900, s-maxage=900" }
      ]
    },
    {
      "source": "/brands/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/equipment/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/listings/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/listings/(.*)/edit",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    },
    {
      "source": "/edit-listing",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    },
    {
      "source": "/edit-listing/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    }
  ],
  "functions": {
    "api/public-listing-page.js": {
      "includeFiles": "dist/index.html"
    }
  }
}
